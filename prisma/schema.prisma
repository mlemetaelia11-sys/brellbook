generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String                   @id @default(cuid())
  name            String
  email           String                   @unique
  phone           String?
  passwordHash    String?
  imageKey        String?
  isPlatformAdmin Boolean                  @default(false)
  emailVerified   DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  business        Business?
  memberships     BusinessMembership[]
  passwordResets  PasswordResetToken[]
  emailTokens     EmailVerificationToken[]
  auditLogs       AuditLog[]
  supportTickets  SupportTicket[]
  supportMessages SupportMessage[]
}

model Business {
  id                    String               @id @default(cuid())
  ownerId               String               @unique
  name                  String
  slug                  String               @unique
  type                  String
  category              String?
  phone                 String
  email                 String?
  whatsappNumber        String?
  city                  String?
  location              String?
  address               String?
  description           String?
  logoUrl               String?
  coverUrl              String?
  accentColor           String               @default("#6C2BFF")
  requireBookingPayment Boolean              @default(false)
  depositPercent        Int                  @default(100)
  timezone              String               @default("Africa/Dar_es_Salaam")
  currency              String               @default("TZS")
  active                Boolean              @default(true)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  owner                 User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  memberships           BusinessMembership[]
  bookings              Booking[]
  customers             Customer[]
  services              Service[]
  staff                 Staff[]
  workingHours          WorkingHour[]
  breaks                Break[]
  holidays              Holiday[]
  reviews               Review[]
  subscription          Subscription?
  payments              Payment[]
  notifications         Notification[]
  auditLogs             AuditLog[]
  supportTickets        SupportTicket[]

  @@index([active])
  @@index([ownerId])
}

model BusinessMembership {
  id         String   @id @default(cuid())
  businessId String
  userId     String
  role       UserRole @default(STAFF)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([userId])
  @@index([businessId, role])
}

model Service {
  id            String         @id @default(cuid())
  businessId    String
  name          String
  description   String?
  price         Decimal        @db.Decimal(12, 2)
  durationMin   Int
  category      String?
  imageUrl      String?
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookings      Booking[]
  staffServices StaffService[]

  @@index([businessId, active])
  @@index([businessId, name])
}

model Customer {
  id         String    @id @default(cuid())
  businessId String
  name       String
  phone      String
  email      String?
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookings   Booking[]
  reviews    Review[]

  @@unique([businessId, phone])
  @@index([businessId, name])
  @@index([businessId, email])
}

model Staff {
  id           String             @id @default(cuid())
  businessId   String
  name         String
  phone        String?
  email        String?
  photoUrl     String?
  active       Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  business     Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  services     StaffService[]
  bookings     Booking[]
  workingHours StaffWorkingHour[]
  daysOff      StaffDayOff[]

  @@index([businessId, active])
  @@index([businessId, name])
}

model StaffService {
  id        String  @id @default(cuid())
  staffId   String
  serviceId String
  staff     Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([staffId, serviceId])
  @@index([serviceId])
}

model StaffWorkingHour {
  id        String  @id @default(cuid())
  staffId   String
  dayOfWeek Int
  openTime  String?
  closeTime String?
  isClosed  Boolean @default(false)
  staff     Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, dayOfWeek])
}

model StaffDayOff {
  id      String   @id @default(cuid())
  staffId String
  date    DateTime
  reason  String?
  staff   Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, date])
  @@index([staffId, date])
}

model Booking {
  id                      String         @id @default(cuid())
  bookingCode             String         @unique
  businessId              String
  serviceId               String
  customerId              String
  staffId                 String?
  serviceNameSnapshot     String
  priceSnapshot           Decimal        @db.Decimal(12, 2)
  durationMinutesSnapshot Int
  customerNameSnapshot    String
  customerPhoneSnapshot   String
  customerEmailSnapshot   String?
  date                    DateTime
  startTime               DateTime
  endTime                 DateTime
  status                  BookingStatus  @default(PENDING)
  notes                   String?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  business                Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer                Customer       @relation(fields: [customerId], references: [id])
  service                 Service        @relation(fields: [serviceId], references: [id])
  staff                   Staff?         @relation(fields: [staffId], references: [id])
  payment                 Payment?
  events                  BookingEvent[]
  review                  Review?

  @@index([businessId, date, status])
  @@index([businessId, startTime, endTime])
  @@index([businessId, customerId])
  @@index([businessId, staffId, startTime])
}

model BookingEvent {
  id        String   @id @default(cuid())
  bookingId String
  type      String
  metadata  Json?
  createdAt DateTime @default(now())
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
}

model WorkingHour {
  id         String   @id @default(cuid())
  businessId String
  dayOfWeek  Int
  openTime   String?
  closeTime  String?
  isClosed   Boolean  @default(false)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, dayOfWeek])
}

model Break {
  id         String   @id @default(cuid())
  businessId String
  dayOfWeek  Int
  startTime  String
  endTime    String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, dayOfWeek])
}

model Holiday {
  id         String   @id @default(cuid())
  businessId String
  date       DateTime
  name       String?
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, date])
}

model Subscription {
  id                 String             @id @default(cuid())
  businessId         String             @unique
  plan               Plan               @default(FREE)
  status             SubscriptionStatus @default(FREE)
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  nextBillingDate    DateTime?
  graceEndsAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  business           Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  payments           Payment[]

  @@index([plan, status])
  @@index([status, currentPeriodEnd])
}

model Payment {
  id                String        @id
  businessId        String
  bookingId         String?       @unique
  subscriptionId    String?
  plan              Plan?
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("TZS")
  status            PaymentStatus @default(PENDING)
  provider          String        @default("PESAPAL")
  merchantReference String        @unique
  trackingId        String?
  providerReference String?
  description       String?
  billingStart      DateTime?
  billingEnd        DateTime?
  metadata          Json?
  createdAt         DateTime      @default(now())
  paidAt            DateTime?
  booking           Booking?      @relation(fields: [bookingId], references: [id])
  business          Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  subscription      Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([businessId, createdAt])
  @@index([status])
  @@index([trackingId])
  @@index([subscriptionId])
}

model Review {
  id         String   @id
  businessId String
  bookingId  String?  @unique
  customerId String
  rating     Int
  comment    String?
  approved   Boolean  @default(false)
  response   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  booking    Booking? @relation(fields: [bookingId], references: [id])
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([businessId, approved])
}

model Notification {
  id         String    @id @default(cuid())
  businessId String?
  type       String
  recipient  String
  subject    String?
  message    String
  status     String    @default("PENDING")
  metadata   Json?
  createdAt  DateTime  @default(now())
  sentAt     DateTime?
  business   Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@index([status])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id         String    @id @default(cuid())
  userId     String?
  businessId String?
  action     String
  entity     String?
  entityId   String?
  metadata   Json?
  createdAt  DateTime  @default(now())
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  business   Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
}

model SupportTicket {
  id         String           @id @default(cuid())
  businessId String?
  userId     String
  category   SupportCategory
  subject    String
  message    String
  status     SupportStatus    @default(OPEN)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  business   Business?        @relation(fields: [businessId], references: [id], onDelete: SetNull)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages   SupportMessage[]

  @@index([businessId, status])
  @@index([userId, createdAt])
}

model SupportMessage {
  id        String        @id @default(cuid())
  ticketId  String
  senderId  String?
  message   String
  createdAt DateTime      @default(now())
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender    User?         @relation(fields: [senderId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
}

enum UserRole {
  OWNER
  MANAGER
  STAFF
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum Plan {
  FREE
  STARTER
  PRO
}

enum SubscriptionStatus {
  FREE
  ACTIVE
  PAST_DUE
  GRACE_PERIOD
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}

enum SupportStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum SupportCategory {
  ACCOUNT
  BOOKING
  SUBSCRIPTION
  PAYMENT
  TECHNICAL
  OTHER
}
