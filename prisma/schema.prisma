generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  MANAGER
  STAFF
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum Plan {
  FREE
  STARTER
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum StrikeStatus {
  ACTIVE
  RESOLVED
}

enum AppealStatus {
  PENDING
  ACCEPTED
  REJECTED
  MORE_INFO
}

enum ProductCode {
  BRELLBOOK
  BRELLFLOW
  BRELLPAY
  BRELLCHAT
  BRELLAI
  BRELLADS
  BRELLSTUDIO
}

model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  passwordHash    String?
  emailVerified   DateTime?
  image           String?
  isPlatformAdmin Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberships     BusinessMembership[]
  oauthAccounts   OAuthAccount[]
  bookingsCreated Booking[]            @relation("BookingCreatedBy")
  supportMessages SupportMessage[]
  strikes         Strike[]             @relation("StrikeUser")
  issuedStrikes   Strike[]             @relation("StrikeIssuer")
  auditLogs       AuditLog[]
  appeals         Appeal[]
}

model Business {
  id                        String   @id @default(cuid())
  name                      String
  slug                      String   @unique
  category                  String
  phone                     String
  whatsapp                  String?
  email                     String?
  address                   String?
  city                      String?
  location                  String?
  logoUrl                   String?
  coverUrl                  String?
  description               String?
  instagram                 String?
  facebook                  String?
  website                   String?
  accentColor               String   @default("#6C2BFF")
  showBranding              Boolean  @default(true)
  minimumNoticeMinutes      Int      @default(60)
  bufferMinutes             Int      @default(0)
  allowCustomerCancellation Boolean  @default(true)
  cancellationNoticeMinutes Int      @default(120)
  allowCustomerRescheduling Boolean  @default(true)
  rescheduleNoticeMinutes   Int      @default(120)
  maxAdvanceDays            Int      @default(60)
  depositEnabled            Boolean  @default(false)
  depositPercent            Int      @default(0)
  reviewEnabled             Boolean  @default(true)
  referralCode              String?  @unique
  active                    Boolean  @default(true)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  memberships     BusinessMembership[]
  services        Service[]
  customers       Customer[]
  bookings        Booking[]
  workingHours    WorkingHour[]
  breaks          Break[]
  holidays        Holiday[]
  staff           Staff[]
  subscription    Subscription?
  payments        Payment[]
  notifications   Notification[]
  supportTickets  SupportTicket[]
  strikes         Strike[]
  appeals         Appeal[]
  auditLogs       AuditLog[]
  reviews         Review[]
  referralsSent   Referral[]           @relation("ReferralBusiness")
  waitlistEntries WaitlistEntry[]
  discountCodes   DiscountCode[]
  marketingEvents MarketingEvent[]
}

model BusinessMembership {
  id         String         @id @default(cuid())
  userId     String
  businessId String
  role       MembershipRole @default(STAFF)
  createdAt  DateTime       @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@index([businessId])
}

model ServiceCategory {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  services Service[]
}

model Service {
  id              String   @id @default(cuid())
  businessId      String
  categoryId      String?
  name            String
  description     String?
  price           Decimal  @db.Decimal(12, 2)
  durationMinutes Int
  imageUrl        String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category        ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  bookings        Booking[]
  staff           StaffService[]
  waitlistEntries WaitlistEntry[]
  marketingEvents MarketingEvent[]

  @@index([businessId, active])
}

model Customer {
  id                 String   @id @default(cuid())
  businessId         String
  name               String
  phone              String
  email              String?
  notes              String?
  discountCodeId     String?
  discountAmount     Decimal  @default(0) @db.Decimal(12, 2)
  finalPriceSnapshot Decimal? @db.Decimal(12, 2)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookings Booking[]
  reviews  Review[]

  @@unique([businessId, phone])
  @@index([businessId, name])
}

model Booking {
  id                      String        @id @default(cuid())
  bookingCode             String        @unique
  businessId              String
  serviceId               String
  customerId              String
  staffId                 String?
  createdByUserId         String?
  discountCodeId          String?
  serviceNameSnapshot     String
  priceSnapshot           Decimal       @db.Decimal(12, 2)
  discountAmount          Decimal       @default(0) @db.Decimal(12, 2)
  finalPriceSnapshot      Decimal?      @db.Decimal(12, 2)
  durationMinutesSnapshot Int
  customerNameSnapshot    String
  customerPhoneSnapshot   String
  customerEmailSnapshot   String?
  date                    DateTime
  startTime               DateTime
  endTime                 DateTime
  status                  BookingStatus @default(PENDING)
  notes                   String?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  business     Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service      Service        @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  customer     Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  staff        Staff?         @relation(fields: [staffId], references: [id], onDelete: SetNull)
  createdBy    User?          @relation("BookingCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  discountCode DiscountCode?  @relation(fields: [discountCodeId], references: [id], onDelete: SetNull)
  events       BookingEvent[]
  review       Review?

  @@index([businessId, startTime, endTime])
  @@index([businessId, date, status])
  @@index([customerId])
  @@index([businessId, status, startTime])
}

model BookingEvent {
  id        String   @id @default(cuid())
  bookingId String
  type      String
  metadata  Json?
  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
}

model WorkingHour {
  id         String  @id @default(cuid())
  businessId String
  dayOfWeek  Int
  isClosed   Boolean @default(false)
  openTime   String?
  closeTime  String?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, dayOfWeek])
}

model Break {
  id         String  @id @default(cuid())
  businessId String
  dayOfWeek  Int?
  startTime  String
  endTime    String
  label      String?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, dayOfWeek])
}

model Holiday {
  id         String   @id @default(cuid())
  businessId String
  date       DateTime
  label      String?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, date])
}

model Staff {
  id         String   @id @default(cuid())
  businessId String
  name       String
  email      String?
  phone      String?
  role       String   @default("STAFF")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  business     Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  services     StaffService[]
  workingHours StaffWorkingHour[]
  bookings     Booking[]

  @@index([businessId, active])
}

model StaffService {
  staffId   String
  serviceId String

  staff   Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([staffId, serviceId])
}

model StaffWorkingHour {
  id        String  @id @default(cuid())
  staffId   String
  dayOfWeek Int
  isClosed  Boolean @default(false)
  openTime  String?
  closeTime String?

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, dayOfWeek])
}

model Subscription {
  id               String             @id @default(cuid())
  businessId       String             @unique
  plan             Plan               @default(FREE)
  status           SubscriptionStatus @default(ACTIVE)
  startDate        DateTime           @default(now())
  expiryDate       DateTime?
  graceUntil       DateTime?
  paymentReference String?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([plan, status])
}

model Payment {
  id                   String        @id @default(cuid())
  businessId           String
  userId               String?
  plan                 Plan
  amount               Decimal       @db.Decimal(12, 2)
  currency             String        @default("TZS")
  status               PaymentStatus @default(PENDING)
  transactionReference String?
  providerReference    String?
  createdAt            DateTime      @default(now())
  verifiedAt           DateTime?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@index([transactionReference])
  @@index([providerReference])
}

model Notification {
  id         String    @id @default(cuid())
  businessId String
  type       String
  recipient  String
  subject    String?
  body       String
  status     String    @default("PENDING")
  metadata   Json?
  createdAt  DateTime  @default(now())
  sentAt     DateTime?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
}

model SupportTicket {
  id         String       @id @default(cuid())
  businessId String
  subject    String
  status     TicketStatus @default(OPEN)
  priority   String       @default("NORMAL")
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  business Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  messages SupportMessage[]

  @@index([businessId, status])
}

model SupportMessage {
  id        String   @id @default(cuid())
  ticketId  String
  userId    String?
  body      String
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
}

model Strike {
  id             String        @id @default(cuid())
  businessId     String
  userId         String?
  issuedByUserId String?
  number         Int
  reason         String
  status         StrikeStatus  @default(ACTIVE)
  appealStatus   AppealStatus?
  notes          String?
  createdAt      DateTime      @default(now())
  resolvedAt     DateTime?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User?    @relation("StrikeUser", fields: [userId], references: [id], onDelete: SetNull)
  issuedBy User?    @relation("StrikeIssuer", fields: [issuedByUserId], references: [id], onDelete: SetNull)
  appeals  Appeal[]

  @@index([businessId, status])
}

model Appeal {
  id          String       @id @default(cuid())
  businessId  String
  userId      String?
  strikeId    String?
  reason      String
  explanation String
  evidenceUrl String?
  status      AppealStatus @default(PENDING)
  adminNotes  String?
  createdAt   DateTime     @default(now())
  reviewedAt  DateTime?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  strike   Strike?  @relation(fields: [strikeId], references: [id], onDelete: SetNull)

  @@index([businessId, status])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  businessId String?
  action     String
  ipAddress  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  business Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([businessId, createdAt])
}

model OAuthAccount {
  id                String  @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  expiresAt         Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Review {
  id         String   @id @default(cuid())
  businessId String
  bookingId  String   @unique
  customerId String
  rating     Int
  comment    String?
  published  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  booking  Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([businessId, published, createdAt])
}

model Referral {
  id                 String   @id @default(cuid())
  businessId         String
  referredBusinessId String?
  code               String
  status             String   @default("PENDING")
  rewardMonths       Int      @default(1)
  createdAt          DateTime @default(now())

  business Business @relation("ReferralBusiness", fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, code])
  @@index([code])
}

model WaitlistEntry {
  id            String    @id @default(cuid())
  businessId    String
  serviceId     String
  name          String
  phone         String
  email         String?
  preferredDate DateTime?
  preferredTime String?
  status        String    @default("WAITING")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([businessId, status, preferredDate])
}

model DiscountCode {
  id         String    @id @default(cuid())
  businessId String
  code       String
  type       String    @default("PERCENT")
  value      Decimal   @db.Decimal(12, 2)
  maxUses    Int?
  usedCount  Int       @default(0)
  expiresAt  DateTime?
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@unique([businessId, code])
  @@index([businessId, active, expiresAt])
}

model MarketingEvent {
  id         String   @id @default(cuid())
  businessId String
  type       String
  serviceId  String?
  sessionId  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service  Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([businessId, type, createdAt])
  @@index([businessId, sessionId, createdAt])
}
