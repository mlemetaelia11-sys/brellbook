generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  MANAGER
  STAFF

  @@map("UserRole")
}
enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum Plan {
  FREE
  STARTER
  PRO
}

enum SubscriptionStatus {
  FREE
  ACTIVE
  PAST_DUE
  GRACE_PERIOD
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model User {
  id                 String @id @default(cuid())
  name               String
  email              String @unique
  phone              String?
  passwordHash       String?
  imageKey           String?
  timezone           String @default("Africa/Dar_es_Salaam")
  locale             String @default("en-TZ")
  isPlatformAdmin    Boolean @default(false)
  emailVerifiedAt    DateTime?
  notificationPrefs  Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  memberships        BusinessMembership[]
  staffProfiles      Staff[]
  auditLogs          AuditLog[]
  notifications      Notification[]
  supportMessages    SupportMessage[]
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
}

model Business {
  id             String @id @default(cuid())
  name           String
  slug           String @unique
  type           String?
  phone          String?
  email          String?
  whatsappNumber String?
  address        String?
  location       String?
  description    String?
  logoKey        String?
  coverKey       String?
  brandColor     String @default("#6C2BFF")
  timezone       String @default("Africa/Dar_es_Salaam")
  currency       String @default("TZS")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  memberships    BusinessMembership[]
  services       Service[]
  customers      Customer[]
  staff          Staff[]
  bookings       Booking[]
  workingHours   WorkingHour[]
  breaks         Break[]
  holidays       Holiday[]
  subscription   Subscription?
  payments       SubscriptionPayment[]
  reviews        Review[]
  auditLogs      AuditLog[]
  tickets        SupportTicket[]
}

model BusinessMembership {
  id         String   @id @default(cuid())
  userId     String
  businessId String
  role       Role
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  @@unique([userId, businessId])
  @@index([businessId])
}

model Service {
  id          String @id @default(cuid())
  businessId  String
  name        String
  description String?
  price       Decimal @db.Decimal(12,2)
  durationMin Int
  category    String?
  imageKey    String?
  active      Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff       StaffService[]
  bookings    Booking[]
  @@index([businessId, active])
}

model Customer {
  id         String @id @default(cuid())
  businessId String
  name       String
  phone      String
  email      String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookings   Booking[]
  reviews    Review[]
  @@unique([businessId, phone])
  @@index([businessId, name])
}

model Staff {
  id         String @id @default(cuid())
  businessId String
  userId     String?
  name       String
  phone      String?
  email      String?
  imageKey   String?
  active     Boolean @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  services   StaffService[]
  bookings   Booking[]
  hours      StaffWorkingHour[]
  @@unique([businessId, userId])
  @@index([businessId, active])
}

model StaffService {
  staffId   String
  serviceId String
  staff     Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  @@id([staffId, serviceId])
}

model Booking {
  id            String @id @default(cuid())
  code          String @unique
  businessId    String
  customerId    String
  serviceId     String
  staffId       String?
  startAt       DateTime
  endAt         DateTime
  price         Decimal @db.Decimal(12,2)
  status        BookingStatus @default(PENDING)
  notes         String?
  paymentStatus PaymentStatus @default(PENDING)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  service       Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  staff         Staff? @relation(fields: [staffId], references: [id], onDelete: SetNull)
  events        BookingEvent[]
  review        Review?
  @@index([businessId, startAt])
  @@index([businessId, customerId, startAt])
  @@index([businessId, serviceId, startAt])
  @@index([businessId, status])
  @@index([staffId, startAt])
}

model BookingEvent {
  id        String @id @default(cuid())
  bookingId String
  type      String
  metadata  Json?
  createdAt DateTime @default(now())
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  @@index([bookingId, createdAt])
}

model WorkingHour {
  id         String @id @default(cuid())
  businessId String
  dayOfWeek  Int
  open       Boolean @default(true)
  openTime   String
  closeTime  String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  @@unique([businessId, dayOfWeek])
}

model Break {
  id         String @id @default(cuid())
  businessId String
  dayOfWeek  Int
  startTime  String
  endTime    String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  @@index([businessId, dayOfWeek])
}

model Holiday {
  id         String @id @default(cuid())
  businessId String
  date       DateTime
  name       String?
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  @@unique([businessId, date])
}

model StaffWorkingHour {
  id        String @id @default(cuid())
  staffId   String
  dayOfWeek Int
  open      Boolean @default(true)
  openTime  String
  closeTime String
  staff     Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)
  @@unique([staffId, dayOfWeek])
}

model Subscription {
  id                 String @id @default(cuid())
  businessId         String @unique
  plan               Plan @default(FREE)
  status             SubscriptionStatus @default(FREE)
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  nextBillingDate    DateTime?
  graceEndsAt        DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  business           Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model SubscriptionPayment {
  id                  String @id @default(cuid())
  businessId          String
  plan                Plan
  amount              Decimal @db.Decimal(12,2)
  currency            String @default("TZS")
  status              PaymentStatus @default(PENDING)
  pesapalOrderId      String?
  pesapalTransactionId String?
  billingStart        DateTime?
  billingEnd          DateTime?
  metadata            Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  business            Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  @@index([businessId, createdAt])
  @@index([pesapalOrderId])
}

model Review {
  id         String @id @default(cuid())
  businessId String
  customerId String
  bookingId  String @unique
  rating     Int
  review     String?
  response   String?
  approved   Boolean @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  booking    Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  @@index([businessId, approved])
}

model Notification {
  id        String @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime @default(now())
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}

model SupportTicket {
  id         String @id @default(cuid())
  businessId String
  subject    String
  category   String
  status     TicketStatus @default(OPEN)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  messages   SupportMessage[]
  @@index([businessId, status])
}

model SupportMessage {
  id        String @id @default(cuid())
  ticketId  String
  senderId  String
  body      String
  createdAt DateTime @default(now())
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender    User @relation(fields: [senderId], references: [id], onDelete: Cascade)
  @@index([ticketId, createdAt])
}

model AuditLog {
  id         String @id @default(cuid())
  userId     String?
  businessId String?
  action     String
  entity     String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  user       User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  business   Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  @@index([businessId, createdAt])
  @@index([userId, createdAt])
}


model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}
